# Copy to .env (cp .env.example .env) and change the passwords. .env is never committed.
POSTGRES_USER=invoicelens
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=invoicelens

# Object storage (SeaweedFS S3 gateway). The same keys are used by the server and the app.
AWS_ACCESS_KEY_ID=invoicelens
AWS_SECRET_ACCESS_KEY=change-me-storage-secret

S3_BUCKET=invoices
LOG_LEVEL=INFO
WORKER_REPLICAS=2
